# Server
PORT=3000

# MySQL connection (create the database first: CREATE DATABASE rehab_centre;)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_NAME=rehab_centre

# JWT
JWT_SECRET=change_this_to_a_long_random_secret

# Initial ADMIN account created by "npm run seed"
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@rehab.local
ADMIN_PASSWORD=Admin@123
